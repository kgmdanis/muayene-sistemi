generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FirmaAyarlari {
  id            Int      @id @default(1)
  name          String   @default("ÖNDER MUAYENE")
  yetkili       String?
  yetkiliUnvan  String?
  logo          String?
  adres         String?
  telefon       String?
  email         String?
  vergiNo       String?
  vergiDairesi  String?
  bankaAdi      String?
  bankaSube     String?
  iban          String?
  mahkemeYeri   String?
  genelSartlar  String?
  teklifUstYazi String?
  muhur         String?
  imza          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id                  Int         @id @default(autoincrement())
  email               String      @unique
  password            String
  plainPassword       String?
  name                String
  role                String      @default("tekniker")
  telefon             String?
  isActive            Boolean     @default(true)
  emailVerified       Boolean     @default(false)
  verificationToken   String?
  resetToken          String?
  resetTokenExpiry    DateTime?
  lastLogin           DateTime?
  lastLoginIP         String?
  sessionTimeout      Int         @default(30)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  emailNotifications  Boolean     @default(true)
  systemNotifications Boolean     @default(true)
  olcumler            FieldData[] @relation("olcumYapan")
  loginLogs           LoginLog[]
  olusturanMuayeneler Muayene[]   @relation("olusturanMuayene")
  muayeneler          Muayene[]   @relation("muayeneEden")
  onaylananMuayeneler Muayene[]   @relation("onaylayan")
  teklifler           Teklif[]
  atananWorkOrders    WorkOrder[] @relation("atananWorkOrder")
  olusturanWorkOrders WorkOrder[] @relation("olusturanWorkOrder")
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  ip        String
  userAgent String?
  basarili  Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Customer {
  id           Int         @id @default(autoincrement())
  unvan        String
  vergiNo      String?
  vergiDairesi String?
  adres        String?
  telefon      String?
  email        String?
  yetkili      String?
  notlar       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  isEmirleri   IsEmri[]
  muayeneler   Muayene[]
  teklifler    Teklif[]
  workOrders   WorkOrder[]
}

model Kategori {
  id        Int      @id @default(autoincrement())
  ad        String   @unique
  sira      Int      @default(0)
  createdAt DateTime @default(now())
  hizmetler Hizmet[]
}

model Hizmet {
  id                 Int           @id @default(autoincrement())
  kod                String        @unique
  ad                 String
  metodKapsam        String?
  standartYonetmelik String?
  birim              String        @default("Adet")
  birimFiyat         Decimal       @default(0) @db.Decimal(10, 2)
  kategoriId         Int
  sablonKodlari      String?       // Virgülle ayrılmış rapor şablon kodları (ör: "FR7.2.82" veya "FR7.2.40,FR7.2.41")
  sira               Int           @default(0)
  akpireditasyon     Boolean       @default(false)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  altGorevler        AltGorev[]
  kategori           Kategori      @relation(fields: [kategoriId], references: [id])
  teklifDetaylari    TeklifDetay[]
}

model Teklif {
  id            Int           @id @default(autoincrement())
  teklifNo      String        @unique
  teklifTarihi  DateTime      @default(now())
  gecerlilikGun Int           @default(30)
  customerId    Int
  konu          String        @default("PERİYODİK KONTROL VE İŞ HİJYENİ ÖLÇÜM FİYAT TEKLİFİ")
  durum         TeklifDurum   @default(TASLAK)
  araToplam     Decimal       @default(0) @db.Decimal(12, 2)
  iskontoOran   Decimal       @default(0) @db.Decimal(5, 2)
  iskontoTutar  Decimal       @default(0) @db.Decimal(12, 2)
  toplamTutar   Decimal       @default(0) @db.Decimal(12, 2)
  kdvOrani      Int           @default(20)
  kdvTutar      Decimal       @default(0) @db.Decimal(12, 2)
  genelToplam   Decimal       @default(0) @db.Decimal(12, 2)
  notlar        String?
  onayTelefon   Boolean       @default(false)
  sahadaOnay    Boolean       @default(false)
  mailGonderimTarihi DateTime?  // Son mail gönderim tarihi
  mailGonderimSayisi Int        @default(0)  // Kaç kez mail atıldığı
  revizeNo      Int           @default(0)  // Revizyon numarası (her güncellemede artar)
  olusturanId   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isEmirleri    IsEmri[]
  muayeneler    Muayene[]
  customer      Customer      @relation(fields: [customerId], references: [id])
  olusturan     User          @relation(fields: [olusturanId], references: [id])
  detaylar      TeklifDetay[]
  workOrders    WorkOrder[]
}

model TeklifDetay {
  id         Int     @id @default(autoincrement())
  teklifId   Int
  hizmetId   Int
  miktar     Int     @default(0)
  birimFiyat Decimal @db.Decimal(10, 2)
  tutar      Decimal @default(0) @db.Decimal(12, 2)
  hizmet     Hizmet  @relation(fields: [hizmetId], references: [id])
  teklif     Teklif  @relation(fields: [teklifId], references: [id], onDelete: Cascade)
}

model Muayene {
  id               Int          @id @default(autoincrement())
  muayeneNo        String       @unique
  teklifId         Int?
  customerId       Int
  muayeneTarihi    DateTime
  muayeneYeri      String
  muayeneEkipman   String
  muayeneSonucu    MuayeneSonuc @default(BEKLEMEDE)
  sertifikaNo      String?
  sertifikaTarihi  DateTime?
  gecerlilikSuresi Int          @default(12)
  raporDosya       String?
  notlar           String?
  muayeneEdenId    Int
  onaylayanId      Int?
  createdBy        Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  olusturan        User         @relation("olusturanMuayene", fields: [createdBy], references: [id])
  customer         Customer     @relation(fields: [customerId], references: [id])
  muayeneEden      User         @relation("muayeneEden", fields: [muayeneEdenId], references: [id])
  onaylayan        User?        @relation("onaylayan", fields: [onaylayanId], references: [id])
  teklif           Teklif?      @relation(fields: [teklifId], references: [id])
}

model WorkOrder {
  id              Int            @id @default(autoincrement())
  workOrderNo     String         @unique
  teklifId        Int?
  customerId      Int
  durum           WorkOrderDurum @default(BEKLEMEDE)
  planliTarih     DateTime?
  tamamlanmaTarih DateTime?
  atananUserId    Int?
  createdBy       Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  fieldData       FieldData[]
  atanan          User?          @relation("atananWorkOrder", fields: [atananUserId], references: [id])
  olusturan       User           @relation("olusturanWorkOrder", fields: [createdBy], references: [id])
  customer        Customer       @relation(fields: [customerId], references: [id])
  teklif          Teklif?        @relation(fields: [teklifId], references: [id])
}

model FieldData {
  id           Int       @id @default(autoincrement())
  workOrderId  Int
  reportType   String
  formData     Json
  sonuc        String?
  pdfPath      String?
  olcumTarihi  DateTime  @default(now())
  olcumYapanId Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  olcumYapan   User      @relation("olcumYapan", fields: [olcumYapanId], references: [id])
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model Personel {
  id                  Int        @id @default(autoincrement())
  adSoyad             String
  unvan               String
  meslek              String?
  diplomaTarihi       String?
  diplomaNo           String?
  ekipnetNo           String?
  telefon             String?
  email               String?
  kategori            String
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  password            String?
  role                String     @default("tekniker")
  username            String?    @unique
  emailNotifications  Boolean    @default(true)
  systemNotifications Boolean    @default(true)
  altGorevler         AltGorev[]
  sistemDosyalar      SistemDosya[]
}

model IsEmri {
  id              Int               @id @default(autoincrement())
  isEmriNo        String            @unique
  teklifId        Int
  customerId      Int
  planliTarih     DateTime?
  baslangicTarihi DateTime?
  bitisTarihi     DateTime?
  durum           String            @default("BEKLIYOR")
  notlar          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  altGorevler     AltGorev[]
  customer        Customer          @relation(fields: [customerId], references: [id])
  teklif          Teklif            @relation(fields: [teklifId], references: [id])
  firmaBilgi      IsEmriFirmaBilgi?
  sistemDosyalar  SistemDosya[]
}

model AltGorev {
  id                       Int                        @id @default(autoincrement())
  isEmriId                 Int
  hizmetId                 Int
  hizmetAdi                String
  kategori                 String
  siraNo                   Int                        @default(1)
  ekipmanAdi               String?
  ekipmanSeriNo            String?
  ekipmanKonum             String?
  ekipmanKapasite          String?
  ekipmanPlaka             String?
  durum                    String                     @default("BEKLIYOR")
  personelId               Int?
  personelAdi              String?
  tamamlanmaTarihi         DateTime?
  raporNo                  String?
  notlar                   String?
  sahaFormu                String?
  createdAt                DateTime                   @default(now())
  hizmet                   Hizmet                     @relation(fields: [hizmetId], references: [id])
  isEmri                   IsEmri                     @relation(fields: [isEmriId], references: [id], onDelete: Cascade)
  personel                 Personel?                  @relation(fields: [personelId], references: [id])
  topraklamaOlcumler       TopraklamaOlcum[]
  elektrikTopraklamaRaporu ElektrikTopraklamaRaporu[]
  kompresorRaporlari       KompresorRaporu[]
  havaTankiRaporlari       HavaTankiRaporu[]
  raporlar                 Rapor[]
  icTesisatRaporlari       ElektrikIcTesisatRaporu[]
}

model IsEmriFirmaBilgi {
  id              Int       @id @default(autoincrement())
  isEmriId        Int       @unique
  sgkSicilNo      String?
  isgKatipId      String?
  isgKatipId2     String?
  isgKatipId3     String?
  isgKatipId4     String?
  enerjiKurulusu  String?
  basvuruNo       String?
  makineOperatoru String?
  kaynak          String?
  ortamNemi       String?
  ortamSicaklik   String?
  olcumYapanAdi   String?
  olcumTarihi     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isEmri          IsEmri    @relation(fields: [isEmriId], references: [id], onDelete: Cascade)
}

model OlcumCihazi {
  id                    Int                        @id @default(autoincrement())
  marka                 String?
  model                 String?
  seriNo                String?
  olcumAraligi          String?
  hassasiyet            String?
  kategori              String?
  durum                 CihazDurum                 @default(AKTIF)
  isActive              Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  cihazAdi              String
  kalibrasyonNo         String?
  kalibrasyonTarihi     DateTime?
  kalibrasyonGecerlilik DateTime?
  sertifikaDosya        String?
  notlar                String?
  topraklamaOlcumler    TopraklamaOlcum[]
  topraklamaRaporlari   ElektrikTopraklamaRaporu[] @relation("TopraklamaCihaz")
  devreRaporlari        ElektrikTopraklamaRaporu[] @relation("DevreCihaz")
  rcdRaporlari          ElektrikTopraklamaRaporu[] @relation("RCDCihaz")
  kalibrasyonGecmisi    KalibrasyonGecmisi[]
}

// Kalibrasyon Geçmişi
model KalibrasyonGecmisi {
  id                    Int          @id @default(autoincrement())
  cihazId               Int
  kalibrasyonTarihi     DateTime
  gecerlilikTarihi      DateTime
  sertifikaNo           String?
  sertifikaDosya        String?
  kalibrasyonYapan      String?
  maliyet               Decimal?     @db.Decimal(10, 2)
  notlar                String?
  createdAt             DateTime     @default(now())
  cihaz                 OlcumCihazi  @relation(fields: [cihazId], references: [id], onDelete: Cascade)
}

enum CihazDurum {
  AKTIF
  SERVISTE
  ARIZALI
  PASIF
}

model TopraklamaOlcum {
  id           Int          @id @default(autoincrement())
  altGorevId   Int
  siraNo       Int          @default(1)
  olcumNoktasi String?
  olcumDegeri  Decimal?     @db.Decimal(10, 4)
  birim        String       @default("Ω")
  sinirDeger   Decimal?     @db.Decimal(10, 4)
  sonuc        String?
  cihazId      Int?
  notlar       String?
  createdAt    DateTime     @default(now())
  altGorev     AltGorev     @relation(fields: [altGorevId], references: [id], onDelete: Cascade)
  cihaz        OlcumCihazi? @relation(fields: [cihazId], references: [id])
}

// =============================================
// ELEKTRİK TOPRAKLAMA RAPORU MODELLERİ
// FR7.2.36 Elektrik Topraklama Ölçüm Raporu
// =============================================

model ElektrikTopraklamaRaporu {
  id                    Int                        @id @default(autoincrement())
  raporNo               String                     @unique
  altGorevId            Int

  // Firma Bilgileri - otomatik gelecek (Customer'dan)
  sgkSicilNo            String?
  isgKatipNo            String?

  // Tarihler - sahada seçilecek
  baslangicTarihi       DateTime?
  bitisTarihi           DateTime?
  baslangicSaati        String?
  bitisSaati            String?

  // Ortam Koşulları
  ortamSicaklik         String?
  ortamNem              String?
  havaDurumu            String?
  zeminNem              String?

  // Ölçüm Metodu
  olcumCevrimEmpedansi  Boolean?                   @default(false)
  olcum3UcluTopraklama  Boolean?                   @default(false)
  olcumKlamp            Boolean?                   @default(false)

  // Kontrol Nedeni
  kontrolNedeni         String?                    @default("periyodik")

  // Proje & Tek Hat Şeması
  projeVar              Boolean?                   @default(false)
  tekHatSemasiVar       Boolean?                   @default(false)

  // Yapı Cinsi (çoklu seçim)
  yapiEv                Boolean?                   @default(false)
  yapiTicari            Boolean?                   @default(false)
  yapiEndustri          Boolean?                   @default(false)
  yapiDiger             Boolean?                   @default(false)

  // Topraklayıcı Tipi (çoklu seçim)
  toprakRing            Boolean?                   @default(false)
  toprakYuzeysel        Boolean?                   @default(false)
  toprakTemel           Boolean?                   @default(false)
  toprakDerin           Boolean?                   @default(false)
  toprakBelirlenemedi   Boolean?                   @default(false)

  // Koruma Önlemi (çoklu seçim)
  korumaEspotansiyel    Boolean?                   @default(false)
  korumaYalitma         Boolean?                   @default(false)
  korumaAyirma          Boolean?                   @default(false)
  korumaKucukGerilim    Boolean?                   @default(false)

  // Kapsamlı Değişiklik & Önceki Kontrol Etiketi
  kapsamliDegisiklik    Boolean?                   @default(false)
  oncekiKontrolEtiketi  Boolean?                   @default(false)

  // Ekipman & Diğer Bilgiler
  enerjiSaglayan        String?
  sebekeGerilimi        String?
  projeBilgileri        String?
  ekipmanKullanimAmaci  String?
  sonKontrolTarihi      String?
  panoTanimi            String?

  // Sonuç
  uygunlukNotu          String?

  // Sistem Tipi (TN veya TT)
  sistemTipi            String                     @default("TN")

  // Şebeke Tipi (genişletilmiş) - TN_S, TN_C, TN_CS, TT, IT
  sebekeTipi            String?
  // Yer Tipi - NORMAL veya TEHLIKELI (RA hesabında 50 veya 25 kullanılır)
  yerTipi               String                     @default("NORMAL")

  // Ölçüm Cihazları (sabit)
  topraklamaCihazId     Int?
  devreCihazId          Int?
  rcdCihazId            Int?

  // Genel Sonuç
  genelSonuc            String?
  aciklama              String?

  // Meta
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  // İlişkiler
  altGorev              AltGorev                   @relation(fields: [altGorevId], references: [id], onDelete: Cascade)
  topraklamaCihaz       OlcumCihazi?               @relation("TopraklamaCihaz", fields: [topraklamaCihazId], references: [id])
  devreCihaz            OlcumCihazi?               @relation("DevreCihaz", fields: [devreCihazId], references: [id])
  rcdCihaz              OlcumCihazi?               @relation("RCDCihaz", fields: [rcdCihazId], references: [id])
  ekipmanBilgi          TopraklamaEkipmanBilgi?
  detayliOlcumler       TopraklamaDetayliOlcum[]
  rcdSecicilik          RCDSecicilik[]
  icTesisatRaporlari    ElektrikIcTesisatRaporu[]
}

// Ekipman Bilgileri - Checkbox alanları
model TopraklamaEkipmanBilgi {
  id                    Int                        @id @default(autoincrement())
  raporId               Int                        @unique

  // Sigortanın Koruduğu Devre Türü (çoklu seçim)
  devreMotor            Boolean                    @default(false)
  devreAydinlatma       Boolean                    @default(false)
  devrePriz             Boolean                    @default(false)
  devreDiger            Boolean                    @default(false)
  devreDigerAciklama    String?

  // Sigorta Tipi (çoklu seçim)
  sigortaTipB           Boolean                    @default(false)
  sigortaTipC           Boolean                    @default(false)
  sigortaTipD           Boolean                    @default(false)

  // Güç Aralığı (çoklu seçim)
  guc05_1kW             Boolean                    @default(false)
  guc1_5kW              Boolean                    @default(false)
  guc5_10kW             Boolean                    @default(false)
  guc10_20kW            Boolean                    @default(false)
  guc20_50kW            Boolean                    @default(false)
  guc50kWUstu           Boolean                    @default(false)

  // RCD Durumu
  rcdVar                Boolean                    @default(false)
  rcdYok                Boolean                    @default(false)

  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  rapor                 ElektrikTopraklamaRaporu   @relation(fields: [raporId], references: [id], onDelete: Cascade)
}

// Detaylı Ölçüm Tablosu - her satır bir ölçüm
model TopraklamaDetayliOlcum {
  id                    Int                        @id @default(autoincrement())
  raporId               Int
  siraNo                Int                        @default(1)

  // Konum Bilgileri
  tabloAdi              String?
  panoAdi               String?
  salterAdi             String?

  // Sigorta Bilgileri
  anmaAkimi             Decimal?                   @db.Decimal(10, 2)  // In (A)
  sigortaTipi           String?                    // B, C veya D

  // Hesaplanan Değerler (Formüller)
  // Ia = Sigorta uygunsuzluk sınırı akımı
  // B tipi: In × 5, C tipi: In × 10, D tipi: In × 20
  ia                    Decimal?                   @db.Decimal(10, 2)

  // Zs = Sınır hat empedansı (TN sistemi için) = 230 / Ia
  zs                    Decimal?                   @db.Decimal(10, 4)

  // RA = Sınır toprak direnci (TT sistemi için) = 50 / Ia
  ra                    Decimal?                   @db.Decimal(10, 4)

  // Ölçülen Değer
  zx                    Decimal?                   @db.Decimal(10, 4)  // Ölçülen empedans/direnç (Ω)

  // Ik = Hesaplanan arıza akımı = 230 / Zx
  ik                    Decimal?                   @db.Decimal(10, 2)

  // RCD Bilgileri
  rcdVarMi              Boolean                    @default(false)
  rcdIn                 Decimal?                   @db.Decimal(10, 2)  // RCD anma akımı In (A)
  rcdIAn                Decimal?                   @db.Decimal(10, 2)  // RCD anma kaçak akımı (mA)
  rcdSure               Decimal?                   @db.Decimal(10, 2)  // RCD açma süresi (ms)

  // Sonuç
  sonuc                 String?                    // UYGUN veya UYGUN_DEGIL
  aciklama              String?

  createdAt             DateTime                   @default(now())

  rapor                 ElektrikTopraklamaRaporu   @relation(fields: [raporId], references: [id], onDelete: Cascade)
}

// RCD Seçicilik Tablosu
model RCDSecicilik {
  id                    Int                        @id @default(autoincrement())
  raporId               Int
  siraNo                Int                        @default(1)

  // Önceki (üst seviye) RCD bilgileri
  oncekiPanoAdi         String?
  oncekiRcdTipi         String?                    // A, AC, B vs
  oncekiIn              Decimal?                   @db.Decimal(10, 2)  // Anma akımı (A)
  oncekiIdn             Decimal?                   @db.Decimal(10, 2)  // Anma kaçak akımı (mA)
  oncekiGecikme         Decimal?                   @db.Decimal(10, 2)  // Gecikme (ms)

  // Son (alt seviye) RCD bilgileri
  sonPanoAdi            String?
  sonRcdTipi            String?
  sonIdn                Decimal?                   @db.Decimal(10, 2)  // Anma kaçak akımı (mA)
  sonTd                 Decimal?                   @db.Decimal(10, 2)  // Açma süresi (ms)

  sonuc                 String?
  aciklama              String?
  createdAt             DateTime                   @default(now())

  rapor                 ElektrikTopraklamaRaporu   @relation(fields: [raporId], references: [id], onDelete: Cascade)
}

enum TeklifDurum {
  TASLAK
  GONDERILDI
  REVIZE
  ONAYLANDI
  REDDEDILDI
  IPTAL
}

enum MuayeneSonuc {
  BEKLEMEDE
  UYGUN
  UYGUN_DEGIL
  SARTLI_UYGUN
}

// =============================================
// KOMPRESÖR MUAYENE RAPORU MODELİ
// FR7.2.21 Kompresör Muayene ve Ölçüm Raporu
// =============================================

model KompresorRaporu {
  id                    Int      @id @default(autoincrement())
  raporNo               String   @unique
  altGorevId            Int

  // Firma/Rapor üst bilgileri
  bolumu                String?
  kontrolTarihi         String?
  raporTarihi           String?
  sonrakiKontrolTarihi  String?
  sgkSicilNo            String?
  isgKatipNo            String?

  // Tarihler
  baslangicTarihi       DateTime?
  bitisTarihi           DateTime?

  // Ekipman Bilgileri
  markasi               String?
  tip                   String?
  seriNo                String?
  imalatYili            String?
  maksBasinc            String?
  durmaBasinci          String?
  tekrarCalismaBasinci  String?

  // Kontrol Soruları (10 adet) - Uygun/Uygun Değil
  soru1ArizaKarti       String?  // Arıza kartı var mı?
  soru2TseCe            String?  // TSE/CE işareti var mı?
  soru3YagToz           String?  // Yağ/toz var mı?
  soru4BasincAyar       String?  // Basınç ayar otomatiği çalışıyor mu?
  soru5KayisKasnak      String?  // Kayış-kasnak koruyucu sacı var mı?
  soru6ElektrikMotor    String?  // Elektrik motoru bağlantılarında gevşeklik var mı?
  soru7VanaHortum       String?  // Vana/hortum kaçağı var mı?
  soru8HavaFiltresi     String?  // Hava filtresi temiz mi?
  soru9YanginSondurucu  String?  // Yangın söndürücü uygun mu?
  soru10UyariTalimat    String?  // Uyarı ve kullanma talimatı uygun mu?

  // Kusur Açıklamaları
  kusurAciklama         String?

  // Notlar
  notlar                String?

  // Sonuç
  genelSonuc            String?

  // Meta
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // İlişkiler
  altGorev              AltGorev @relation(fields: [altGorevId], references: [id], onDelete: Cascade)
}

// =============================================
// HAVA TANKI MUAYENE RAPORU MODELİ
// FR7.2.156 Hava Tankı Muayene ve Ölçüm Raporu
// =============================================

model HavaTankiRaporu {
  id                       Int      @id @default(autoincrement())
  raporNo                  String   @unique
  altGorevId               Int

  // Firma/Rapor üst bilgileri
  bolumu                   String?
  kontrolTarihi            String?
  raporTarihi              String?
  sonrakiKontrolTarihi     String?
  sgkSicilNo               String?
  isgKatipNo               String?

  // Tarihler
  baslangicTarihi          DateTime?
  bitisTarihi              DateTime?

  // Ekipman Teknik Özellikleri
  markasi                  String?
  tip                      String?
  seriNo                   String?
  imalatYili               String?
  tasarimBasinci           String?
  uretimTestBasinci        String?
  isletmeBasinci           String?
  testBasinci              String?
  hacmi                    String?
  emniyetVentilAcmaBasinci String?

  // Basınç Kaynağı Bilgileri
  basincKaynagiAdi         String?
  basincKaynagiSeriNo      String?

  // Test Değerleri
  testTarihi               String?
  hidrostatikTestDegeri    String?
  emniyetValfiTestiDegeri  String?

  // Kontrol Kriterleri (10 adet) - Uygun/Uygun Değil
  kriter1                  String?
  kriter2                  String?
  kriter3                  String?
  kriter4                  String?
  kriter5                  String?
  kriter6                  String?
  kriter7                  String?
  kriter8                  String?
  kriter9                  String?
  kriter10                 String?
  testHidrostatik          String?
  testEmniyetValfi         String?

  // Kusur Açıklamaları
  kusurAciklama            String?

  // Notlar
  notlar                   String?

  // Sonuç
  genelSonuc               String?

  // Meta
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // İlişkiler
  altGorev                 AltGorev @relation(fields: [altGorevId], references: [id], onDelete: Cascade)
}

// ============ GENERIC RAPOR SİSTEMİ ============

model Rapor {
  id              Int      @id @default(autoincrement())
  raporNo         String   @unique
  sablonKodu      String
  altGorevId      Int
  sgkSicilNo      String?
  isgKatipNo      String?
  baslangicTarihi DateTime?
  bitisTarihi     DateTime?
  genelSonuc      String?
  formData        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  altGorev        AltGorev @relation(fields: [altGorevId], references: [id], onDelete: Cascade)

  @@index([sablonKodu])
  @@index([altGorevId])
}

model RaporSablonu {
  id           Int      @id @default(autoincrement())
  sablonKodu   String   @unique
  sablonAdi    String
  kategori     String
  config       Json
  wordTemplate String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SistemDosya {
  id          Int       @id @default(autoincrement())
  dosyaAdi    String
  dosyaYolu   String
  dosyaTipi   String    // "kapak", "kalibrasyon", "egitim", "diger"
  kategori    String?   // "elektrik", "mekanik"
  aciklama    String?
  personelId  Int?
  isEmriId    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  personel    Personel? @relation(fields: [personelId], references: [id])
  isEmri      IsEmri?   @relation(fields: [isEmriId], references: [id])
}

// =============================================
// ELEKTRİK İÇ TESİSAT RAPORU MODELLERİ
// FR7.2.40 Elektrik İç Tesisat Ölçüm Raporu
// =============================================

model ElektrikIcTesisatRaporu {
  id                    Int                        @id @default(autoincrement())
  raporNo               String                     @unique
  altGorevId            Int

  // Rapor tipi checkboxları
  raporTipiTopraklama   Boolean                    @default(false)
  raporTipiIcTesisat    Boolean                    @default(true)

  // Firma bilgileri
  sgkSicilNo            String?
  isgKatipNo            String?

  // Tarihler
  baslangicTarihi       DateTime?
  bitisTarihi           DateTime?

  // Ortam
  sicaklik              String?    @map("ortamSicaklik")
  nem                   String?    @map("ortamNem")

  // Sistem tipi
  sistemTipi            String                     @default("TN")
  sebekeTipi            String?
  yerTipi               String                     @default("NORMAL")

  // Topraklama raporu FK
  topraklamaRaporuId    Int?

  // Ekipman bilgileri
  enerjiFirma           String?    @map("enerjiSaglayan")
  dkdSpd                String?    @map("dkdSpdKullanildi")
  sonKontrolTarihi      DateTime?
  ilaveTopraklamaElektrotu String?
  kullanimAmaci         String?    @map("ekipmanKullanimAmaci")

  // Notlar
  genelNotlar           String?    @map("notlar")

  // Koruyucu önlemler ve ölçüm metodu (JSON dizisi)
  koruyucuOnlemler      String?
  olcumMetodu           String?

  // 2.1 Ek alanlar
  fazIletkenSayisiTipi  String?    @map("fazIletkenTipi")
  temelTopraklamaDirenci String?
  sistemTopraklamaIletkeni String?
  anaEspotansiyelIletkeni String?
  nominalGerilim        String?    @map("beslemeNominalGerilim")
  nominalFrekans        String?    @map("beslemeNominalFrekans")
  hataAkimi             String?    @map("beslemeHataAkimi")
  cevrimEmpedansi       String?    @map("beslemeCevrimEmpedans")
  anaRcdAnmaAkimi       String?
  anaKesiciTipi         String?
  anaKesiciNominalAkim  String?
  anaRcdTestAkimi       String?

  // Genel Sonuç
  genelSonuc            String?
  sonucAciklama         String?    @map("aciklama")
  formData              Json                       @default("{}")

  // Meta
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  // İlişkiler
  altGorev              AltGorev                   @relation(fields: [altGorevId], references: [id], onDelete: Cascade)
  topraklamaRaporu      ElektrikTopraklamaRaporu?   @relation(fields: [topraklamaRaporuId], references: [id])
  panolar               IcTesisatPano[]
  linyeler              IcTesisatLinye[]
  potansiyelDengeleme   IcTesisatPotansiyelDengeleme[]
  zeminIzolasyon        IcTesisatZeminIzolasyon[]
  fotograflar           IcTesisatFoto[]
}

model IcTesisatPano {
  id                    Int                        @id @default(autoincrement())
  raporId               Int
  siraNo                Int                        @default(1)
  panoAdi               String?

  // 27 kriter (U=Uygun, UD=Uygun Değil, UY=Uygulanamaz)
  kriter1               String?    @default("U")
  kriter2               String?    @default("U")
  kriter3               String?    @default("U")
  kriter4               String?    @default("U")
  kriter5               String?    @default("U")
  kriter6               String?    @default("U")
  kriter7               String?    @default("U")
  kriter8               String?    @default("U")
  kriter9               String?    @default("U")
  kriter10              String?    @default("U")
  kriter11              String?    @default("U")
  kriter12              String?    @default("U")
  kriter13              String?    @default("U")
  kriter14              String?    @default("U")
  kriter15              String?    @default("U")
  kriter16              String?    @default("U")
  kriter17              String?    @default("U")
  kriter18              String?    @default("U")
  kriter19              String?    @default("U")
  kriter20              String?    @default("U")
  kriter21              String?    @default("U")
  kriter22              String?    @default("U")
  kriter23              String?    @default("U")
  kriter24              String?    @default("U")
  kriter25              String?    @default("U")
  kriter26              String?    @default("U")
  kriter27              String?    @default("U")

  // Pano ölçüm değerleri
  panoZx                String?    // Faz-toprak çevrim empedansı (ohm)
  panoZln               String?    // Faz-nötr çevrim empedansı (ohm)
  panoVff               String?    @map("gerilimFF")    // Faz-Faz gerilimi (V)
  panoVln               String?    @map("gerilimLN")    // Faz-Nötr gerilimi (V)
  panoVnpe              String?    @map("gerilimNPE")   // Nötr-PE gerilimi (V)
  panoIkk               String?    @map("kisaDevreAkimi3Faz")  // 3 fazlı kısa devre akımı (kA)
  panoDkdTipi           String?    @map("dkdTipi")      // DKD tipi
  panoDkdAkim           String?    @map("dkdDayanmaAkimi")     // DKD dayanma akımı (kA)

  // Termal kamera
  termalFotografTarihi  String?    @map("termalFotoTarih")
  termalFotografNo      String?    @map("termalFotoNo")

  aciklama              String?
  createdAt             DateTime                   @default(now())

  rapor                 ElektrikIcTesisatRaporu     @relation(fields: [raporId], references: [id], onDelete: Cascade)
}

model IcTesisatLinye {
  id                    Int                        @id @default(autoincrement())
  raporId               Int
  siraNo                Int                        @default(1)

  panoLinyeAdi          String?                    @map("panoAdi")
  egriTipi              String?                    // B, C, D, TMS
  kutupSayisi           String?                    // 1P, 2P, 3P, 4P
  inA                   Decimal?                   @db.Decimal(10, 2)
  icuKA                 Decimal?                   @db.Decimal(10, 2)
  fazKesiti             String?                    @map("kesitFaz")
  nKesiti               String?                    @map("kesitN")
  peKesiti              String?                    @map("kesitPE")
  ibA                   Decimal?                   @db.Decimal(10, 2)    @map("ib")
  izA                   Decimal?                   @db.Decimal(10, 2)    @map("iz")
  zxOhm                 Decimal?                   @db.Decimal(10, 4)    @map("zx")
  rcdIAn                Decimal?                   @db.Decimal(10, 2)
  rcdTSuresi            Decimal?                   @db.Decimal(10, 2)    @map("rcdTd")

  // Hesaplanan değerler
  ia                    Decimal?                   @db.Decimal(10, 2)
  zsRa                  Decimal?                   @db.Decimal(10, 4)
  ik1                   Decimal?                   @db.Decimal(10, 2)

  koordinasyonSonuc     String?
  peKesitSonuc          String?
  sonuc                 String?
  notKodu               String?

  createdAt             DateTime                   @default(now())

  rapor                 ElektrikIcTesisatRaporu     @relation(fields: [raporId], references: [id], onDelete: Cascade)
}

model IcTesisatPotansiyelDengeleme {
  id                    Int                        @id @default(autoincrement())
  raporId               Int
  siraNo                Int                        @default(1)

  olcumNoktasi          String?
  iletkenKesiti         String?
  sureklillikOhm        Decimal?                   @db.Decimal(10, 4)
  tamamlayiciKesit      String?
  tamamlayiciSureklilik Decimal?                   @db.Decimal(10, 4)
  sonuc                 String?

  createdAt             DateTime                   @default(now())

  rapor                 ElektrikIcTesisatRaporu     @relation(fields: [raporId], references: [id], onDelete: Cascade)
}

model IcTesisatZeminIzolasyon {
  id                    Int                        @id @default(autoincrement())
  raporId               Int
  siraNo                Int                        @default(1)

  olcumNoktasi          String?
  eni                   Decimal?                   @db.Decimal(10, 2)
  boyu                  Decimal?                   @db.Decimal(10, 2)
  izolasyonDirenciKOhm  Decimal?                   @db.Decimal(10, 4)
  sinirDeger            Decimal                    @default(50)  @db.Decimal(10, 4)
  sonuc                 String?

  createdAt             DateTime                   @default(now())

  rapor                 ElektrikIcTesisatRaporu     @relation(fields: [raporId], references: [id], onDelete: Cascade)
}

model IcTesisatFoto {
  id          Int      @id @default(autoincrement())
  raporId     Int
  panoId      Int?
  fotoTipi    String   // "ekipman" veya "termal"
  dosyaYolu   String
  dosyaAdi    String?
  aciklama    String?
  siraNo      Int      @default(1)
  createdAt   DateTime @default(now())

  rapor       ElektrikIcTesisatRaporu @relation(fields: [raporId], references: [id], onDelete: Cascade)
}

enum WorkOrderDurum {
  BEKLEMEDE
  ATANDI
  SAHADA
  TAMAMLANDI
  IPTAL
}
