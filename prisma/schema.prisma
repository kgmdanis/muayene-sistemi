generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FirmaAyarlari {
  id            Int      @id @default(1)
  name          String   @default("ÖNDER MUAYENE")
  yetkili       String?
  yetkiliUnvan  String?
  logo          String?
  adres         String?
  telefon       String?
  email         String?
  vergiNo       String?
  vergiDairesi  String?
  bankaAdi      String?
  bankaSube     String?
  iban          String?
  mahkemeYeri   String?
  genelSartlar  String?
  teklifUstYazi String?
  muhur         String?
  imza          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id                  Int         @id @default(autoincrement())
  email               String      @unique
  password            String
  plainPassword       String?
  name                String
  role                String      @default("tekniker")
  telefon             String?
  isActive            Boolean     @default(true)
  emailVerified       Boolean     @default(false)
  verificationToken   String?
  resetToken          String?
  resetTokenExpiry    DateTime?
  lastLogin           DateTime?
  lastLoginIP         String?
  sessionTimeout      Int         @default(30)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  emailNotifications  Boolean     @default(true)
  systemNotifications Boolean     @default(true)
  olcumler            FieldData[] @relation("olcumYapan")
  loginLogs           LoginLog[]
  olusturanMuayeneler Muayene[]   @relation("olusturanMuayene")
  muayeneler          Muayene[]   @relation("muayeneEden")
  onaylananMuayeneler Muayene[]   @relation("onaylayan")
  teklifler           Teklif[]
  atananWorkOrders    WorkOrder[] @relation("atananWorkOrder")
  olusturanWorkOrders WorkOrder[] @relation("olusturanWorkOrder")
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  ip        String
  userAgent String?
  basarili  Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Customer {
  id           Int         @id @default(autoincrement())
  unvan        String
  vergiNo      String?
  vergiDairesi String?
  adres        String?
  telefon      String?
  email        String?
  yetkili      String?
  notlar       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  isEmirleri   IsEmri[]
  muayeneler   Muayene[]
  teklifler    Teklif[]
  workOrders   WorkOrder[]
}

model Kategori {
  id        Int      @id @default(autoincrement())
  ad        String   @unique
  sira      Int      @default(0)
  createdAt DateTime @default(now())
  hizmetler Hizmet[]
}

model Hizmet {
  id                 Int           @id @default(autoincrement())
  kod                String        @unique
  ad                 String
  metodKapsam        String?
  standartYonetmelik String?
  birim              String        @default("Adet")
  birimFiyat         Decimal       @default(0) @db.Decimal(10, 2)
  kategoriId         Int
  sira               Int           @default(0)
  akpireditasyon     Boolean       @default(false)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  altGorevler        AltGorev[]
  kategori           Kategori      @relation(fields: [kategoriId], references: [id])
  teklifDetaylari    TeklifDetay[]
}

model Teklif {
  id            Int           @id @default(autoincrement())
  teklifNo      String        @unique
  teklifTarihi  DateTime      @default(now())
  gecerlilikGun Int           @default(30)
  customerId    Int
  konu          String        @default("PERİYODİK KONTROL VE İŞ HİJYENİ ÖLÇÜM FİYAT TEKLİFİ")
  durum         TeklifDurum   @default(TASLAK)
  araToplam     Decimal       @default(0) @db.Decimal(12, 2)
  iskontoOran   Decimal       @default(0) @db.Decimal(5, 2)
  iskontoTutar  Decimal       @default(0) @db.Decimal(12, 2)
  toplamTutar   Decimal       @default(0) @db.Decimal(12, 2)
  kdvOrani      Int           @default(20)
  kdvTutar      Decimal       @default(0) @db.Decimal(12, 2)
  genelToplam   Decimal       @default(0) @db.Decimal(12, 2)
  notlar        String?
  onayTelefon   Boolean       @default(false)
  sahadaOnay    Boolean       @default(false)
  olusturanId   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isEmirleri    IsEmri[]
  muayeneler    Muayene[]
  customer      Customer      @relation(fields: [customerId], references: [id])
  olusturan     User          @relation(fields: [olusturanId], references: [id])
  detaylar      TeklifDetay[]
  workOrders    WorkOrder[]
}

model TeklifDetay {
  id         Int     @id @default(autoincrement())
  teklifId   Int
  hizmetId   Int
  miktar     Int     @default(0)
  birimFiyat Decimal @db.Decimal(10, 2)
  tutar      Decimal @default(0) @db.Decimal(12, 2)
  hizmet     Hizmet  @relation(fields: [hizmetId], references: [id])
  teklif     Teklif  @relation(fields: [teklifId], references: [id], onDelete: Cascade)
}

model Muayene {
  id               Int          @id @default(autoincrement())
  muayeneNo        String       @unique
  teklifId         Int?
  customerId       Int
  muayeneTarihi    DateTime
  muayeneYeri      String
  muayeneEkipman   String
  muayeneSonucu    MuayeneSonuc @default(BEKLEMEDE)
  sertifikaNo      String?
  sertifikaTarihi  DateTime?
  gecerlilikSuresi Int          @default(12)
  raporDosya       String?
  notlar           String?
  muayeneEdenId    Int
  onaylayanId      Int?
  createdBy        Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  olusturan        User         @relation("olusturanMuayene", fields: [createdBy], references: [id])
  customer         Customer     @relation(fields: [customerId], references: [id])
  muayeneEden      User         @relation("muayeneEden", fields: [muayeneEdenId], references: [id])
  onaylayan        User?        @relation("onaylayan", fields: [onaylayanId], references: [id])
  teklif           Teklif?      @relation(fields: [teklifId], references: [id])
}

model WorkOrder {
  id              Int            @id @default(autoincrement())
  workOrderNo     String         @unique
  teklifId        Int?
  customerId      Int
  durum           WorkOrderDurum @default(BEKLEMEDE)
  planliTarih     DateTime?
  tamamlanmaTarih DateTime?
  atananUserId    Int?
  createdBy       Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  fieldData       FieldData[]
  atanan          User?          @relation("atananWorkOrder", fields: [atananUserId], references: [id])
  olusturan       User           @relation("olusturanWorkOrder", fields: [createdBy], references: [id])
  customer        Customer       @relation(fields: [customerId], references: [id])
  teklif          Teklif?        @relation(fields: [teklifId], references: [id])
}

model FieldData {
  id           Int       @id @default(autoincrement())
  workOrderId  Int
  reportType   String
  formData     Json
  sonuc        String?
  pdfPath      String?
  olcumTarihi  DateTime  @default(now())
  olcumYapanId Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  olcumYapan   User      @relation("olcumYapan", fields: [olcumYapanId], references: [id])
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model Personel {
  id                  Int        @id @default(autoincrement())
  adSoyad             String
  unvan               String
  meslek              String?
  diplomaTarihi       String?
  diplomaNo           String?
  ekipnetNo           String?
  telefon             String?
  email               String?
  kategori            String
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  password            String?
  role                String     @default("tekniker")
  username            String?    @unique
  emailNotifications  Boolean    @default(true)
  systemNotifications Boolean    @default(true)
  altGorevler         AltGorev[]
}

model IsEmri {
  id              Int               @id @default(autoincrement())
  isEmriNo        String            @unique
  teklifId        Int
  customerId      Int
  planliTarih     DateTime?
  baslangicTarihi DateTime?
  bitisTarihi     DateTime?
  durum           String            @default("BEKLIYOR")
  notlar          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  altGorevler     AltGorev[]
  customer        Customer          @relation(fields: [customerId], references: [id])
  teklif          Teklif            @relation(fields: [teklifId], references: [id])
  firmaBilgi      IsEmriFirmaBilgi?
}

model AltGorev {
  id                 Int               @id @default(autoincrement())
  isEmriId           Int
  hizmetId           Int
  hizmetAdi          String
  kategori           String
  siraNo             Int               @default(1)
  ekipmanAdi         String?
  ekipmanSeriNo      String?
  ekipmanKonum       String?
  ekipmanKapasite    String?
  ekipmanPlaka       String?
  durum              String            @default("BEKLIYOR")
  personelId         Int?
  personelAdi        String?
  tamamlanmaTarihi   DateTime?
  raporNo            String?
  notlar             String?
  sahaFormu          String?
  createdAt          DateTime          @default(now())
  hizmet             Hizmet            @relation(fields: [hizmetId], references: [id])
  isEmri             IsEmri            @relation(fields: [isEmriId], references: [id], onDelete: Cascade)
  personel           Personel?         @relation(fields: [personelId], references: [id])
  topraklamaOlcumler TopraklamaOlcum[]
}

model IsEmriFirmaBilgi {
  id              Int       @id @default(autoincrement())
  isEmriId        Int       @unique
  sgkSicilNo      String?
  isgKatipId      String?
  enerjiKurulusu  String?
  basvuruNo       String?
  makineOperatoru String?
  kaynak          String?
  ortamNemi       String?
  ortamSicaklik   String?
  olcumYapanAdi   String?
  olcumTarihi     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isEmri          IsEmri    @relation(fields: [isEmriId], references: [id], onDelete: Cascade)
}

model OlcumCihazi {
  id                    Int               @id @default(autoincrement())
  marka                 String?
  model                 String?
  seriNo                String?
  olcumAraligi          String?
  hassasiyet            String?
  kategori              String?
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  cihazAdi              String
  kalibrasyonNo         String?
  kalibrasyonTarihi     DateTime?
  kalibrasyonGecerlilik DateTime?
  topraklamaOlcumler    TopraklamaOlcum[]
}

model TopraklamaOlcum {
  id           Int          @id @default(autoincrement())
  altGorevId   Int
  siraNo       Int          @default(1)
  olcumNoktasi String?
  olcumDegeri  Decimal?     @db.Decimal(10, 4)
  birim        String       @default("Ω")
  sinirDeger   Decimal?     @db.Decimal(10, 4)
  sonuc        String?
  cihazId      Int?
  notlar       String?
  createdAt    DateTime     @default(now())
  altGorev     AltGorev     @relation(fields: [altGorevId], references: [id], onDelete: Cascade)
  cihaz        OlcumCihazi? @relation(fields: [cihazId], references: [id])
}

enum TeklifDurum {
  TASLAK
  GONDERILDI
  ONAYLANDI
  REDDEDILDI
  IPTAL
}

enum MuayeneSonuc {
  BEKLEMEDE
  UYGUN
  UYGUN_DEGIL
  SARTLI_UYGUN
}

enum WorkOrderDurum {
  BEKLEMEDE
  ATANDI
  SAHADA
  TAMAMLANDI
  IPTAL
}

// ============ ŞABLON YÖNETİMİ ============

model Sablon {
  id              Int            @id @default(autoincrement())
  kod             String         @unique // FR7.2.36 gibi
  ad              String         // Elektrik Topraklama Ölçüm Raporu
  aciklama        String?        // Şablon açıklaması
  kategori        String         // Elektrik, Basınçlı Kap, vb.
  dosyaYolu       String         // templates/elektrik/FR7.2.36.docx
  dosyaAdi        String         // Orijinal dosya adı
  dosyaBoyutu     Int            @default(0) // Byte cinsinden
  tabloSayisi     Int            @default(0) // Word'deki tablo sayısı
  alanlar         Json?          // Şablondaki form alanları (JSON)
  varsayilanDeger Json?          // Varsayılan değerler (JSON)
  aktif           Boolean        @default(true)
  sira            Int            @default(0) // Sıralama
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  raporlar        UretilenRapor[]
}

model SablonAlan {
  id              Int      @id @default(autoincrement())
  sablonKod       String   // Şablon kodu referansı
  alanAdi         String   // firma_adi, rapor_tarihi vb.
  alanEtiketi     String   // "Firma Adı", "Rapor Tarihi" vb.
  alanTipi        String   @default("text") // text, date, number, select, textarea
  zorunlu         Boolean  @default(false)
  varsayilanDeger String?
  secenekler      Json?    // Select için seçenekler
  sira            Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([sablonKod, alanAdi])
}

model UretilenRapor {
  id              Int       @id @default(autoincrement())
  raporNo         String    @unique // ET-2025-001-01
  sablonId        Int
  customerId      Int?
  isEmriId        Int?
  altGorevId      Int?
  formVerileri    Json      // Doldurulmuş form verileri
  sonuc           String?   // UYGUN, UYGUN_DEGIL, SARTLI_UYGUN
  wordDosyasi     String?   // Üretilen Word dosyasının yolu
  pdfDosyasi      String?   // Üretilen PDF dosyasının yolu
  olusturanId     Int?
  olusturmaTarihi DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sablon          Sablon    @relation(fields: [sablonId], references: [id])
}
