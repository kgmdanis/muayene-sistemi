            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter12",
          "no": 12,
          "text": "Kriko yük takozu ileri-geri ve sağa-sola kaydırma ma kilidi var mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter13",
          "no": 13,
