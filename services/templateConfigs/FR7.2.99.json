    {
      "id": "kontrol",
      "title": "Tespit ve Değerlendirme",
      "type": "control-questions",
      "badge": "20 Kontrol",
      "questions": [
        {
          "id": "kriter1",
          "no": 1,
          "text": "Çalışmaya başlamadan önce yerde bulunan talaş , su ve yağ gibi malzemeler temizleniyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter2",
          "no": 2,
          "text": "CNC tezgahının kapılarında swich bulunmakta mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter3",
          "no": 3,
          "text": "CNC tezgahının acil stop butonu var mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter4",
          "no": 4,
          "text": "Tezgah içinde ki aydınlatmalar yeterli mi?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter5",
          "no": 5,
          "text": "Soğutma fanları uygun çalışmakta mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter6",
          "no": 6,
          "text": "Günlük pompa ünitesi yağ miktarı ve basıncının kontrolü yapılıyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter7",
          "no": 7,
          "text": "Günlük yağ miktarı ve hava ünitesinin basıncı kontrol ediliyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter8",
          "no": 8,
          "text": "Günlük kızak yağlama ünitesi yağ miktarı ve basıncının kontrolü yapılıyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter9",
          "no": 9,
          "text": "Günlük tabla yağlama yağı kontrol ediliyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter10",
          "no": 10,
          "text": "Günlük Fener mili soğutma ünitesi yağ miktarı ve basıncı kontrol ediliyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter11",
          "no": 11,
          "text": "Günlük Ana kol yağlama yağı miktarının kontrolü yapılıyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter12",
          "no": 12,
          "text": "Günlük Soğutucu ünitesi sıvı miktarının kontrolü yapılıyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter13",
          "no": 13,
          "text": "(Haftalık )Pompa ünitesinde yağ kaçağı var mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter14",
          "no": 14,
          "text": "(Haftalık )Kontrol paneli soğutma ünitesi uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter15",
          "no": 15,
          "text": "(Haftalık )Magazin operasyon noktası uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter16",
          "no": 16,
          "text": "(Haftalık )Ön kapak ile fener mili arasında ki mesafe uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter17",
          "no": 17,
          "text": "(Aylık )Fener mili dönerken uygunsuz bir gürültü var mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter18",
          "no": 18,
          "text": "(Aylık )Fener mili takımının sıkma ünitesi greslenmekte mi?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter19",
          "no": 19,
          "text": "(Yıllık )Magazin zinciri gerginliği kontrol edilip ayarı yapılıyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter20",
          "no": 20,
          "text": "(Yıllık )Her bir ünitenin yağ durumu kontrol ediliyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        }
      ]
    },
