    {
      "id": "kontrol",
      "title": "Kontrol Kriterleri ve Testler",
      "type": "control-questions",
      "badge": "38 Kontrol",
      "questions": [
        { "id": "kriter1", "no": 1, "text": "Yangın pompa dairesinin sıcaklığı uygun değerlerdedir.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter2", "no": 2, "text": "Yangın pompası debi ve basınç bilgileri proje ile uyumludur.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter3", "no": 3, "text": "Yangın pompaları yedeklemesi kapasite ve miktar yönünden uygundur.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter4", "no": 4, "text": "Yangın pompa performans test sonuçları uygundur.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter5", "no": 5, "text": "Yönetmelik ve standartlara uygun yangın tesisatı mekanik projesi vardır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter6", "no": 6, "text": "Yangın tesisatı uygulaması projesi ile uyumludur.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter7", "no": 7, "text": "Su deposu kapasitesi yönetmelik ve standart ile uyumludur.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter8", "no": 8, "text": "Su deposunun beslemeleri otomatik olarak sağlanmaktadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter9", "no": 9, "text": "Besleme borusu ve kontrol vana seti uygun sıcaklıkta muhafaza edilmektedir.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter10", "no": 10, "text": "Yangın dolabı konumları uygundur.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter11", "no": 11, "text": "Yangın dolaplarının birbirlerine olan mesafeleri uygundur.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter12", "no": 12, "text": "Yangın dolapları ilgili standart normlarına uygundur.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter13", "no": 13, "text": "Yangın dolabı kapağı uygun açılmaktadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter14", "no": 14, "text": "Yangın dolabı hasarsız ve bileşenlerinde aşınma/sızdırma bulunmamaktadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter15", "no": 15, "text": "Yangın dolabı tamburu serbestçe dönebilmektedir.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter16", "no": 16, "text": "Yangın dolabı vanaları doğru ve uygun tiptedir.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter17", "no": 17, "text": "Yangın dolabı vanaları çalışır durumdadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter18", "no": 18, "text": "Yangın dolabı hortumları normlarına uygundur.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter19", "no": 19, "text": "Yangın dolabı hortumlarında hasar çatlama yıpranma bulunmamaktadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter20", "no": 20, "text": "Yangın pompaları mevcuttur.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter21", "no": 21, "text": "Yangın pompa dairesi/odası bulunmakta ve amacı dışında kullanılmamaktadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter22", "no": 22, "text": "Yangın pompa dairesinde uygun drenaj gideri düzenlenmiştir.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter23", "no": 23, "text": "Yangın pompalarında hava boşaltma valfi bulunmakta ve çalışır durumdadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter24", "no": 24, "text": "Yangın pompalarında sirkülasyon rahatlatma valfi bulunmakta ve çalışır durumdadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter25", "no": 25, "text": "Her bir yangın pompasının basınç kontrol anahtarı bulunmakta ve çalışır durumdadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter26", "no": 26, "text": "Her bir yangın pompasının ayrı bir basınç hissetme hattı bulunmakta ve çalışır durumdadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter27", "no": 27, "text": "Her bir pompanın ayrı bir kumanda panosu bulunmakta ve çalışır durumdadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter28", "no": 28, "text": "Yangın pompa emişinde bağlantı konik veya düzdür.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter29", "no": 29, "text": "Yangın pompalarının giriş ve çıkışlarında uygun tipte basınç göstergeleri bulunmakta ve okunur durumdadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter30", "no": 30, "text": "Basınç sabitleme pompası tesis edilmiş ise uygun debi ve basınç kapasitesindedir.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter31", "no": 31, "text": "Yangın pompalarının enerji beslemesi güvenilir kaynaktan yapılmaktadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter32", "no": 32, "text": "Debi ölçümü için debimetre tesis edilmiş veya bulundurulmaktadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter33", "no": 33, "text": "Yangın dolabı hortumları 30 m uzunluğu aşmamaktadır. (TS EN 671-1)", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter34", "no": 34, "text": "Yangın dolabı hortumları lans kapama, püskürtme veya fıskiye yapabilmektedir.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter35", "no": 35, "text": "Yangın dolabında suyun akışı sabit ve yeterli düzeydedir.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter36", "no": 36, "text": "Yangın dolabı hattında basınç değeri 4-9 bar arasındadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter37", "no": 37, "text": "Sabit boru sistemi ve bağlantı noktaları üzerinde korozyon bulunmamaktadır.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" },
        { "id": "kriter38", "no": 38, "text": "Boru tesisatı sabitlemesi uygundur.", "options": ["Uygun", "Uygun Değil", "Uygulanamaz"], "default": "Uygun" }
      ]
    },
