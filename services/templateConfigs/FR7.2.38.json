          "id": "topraklamaDirenciSonuc",
          "label": "Sonuç",
          "type": "select",
          "options": ["UYGUN", "UYGUN DEĞİL"],
          "default": "UYGUN"
        }
      ]
    },
    {
      "id": "kontrol",
      "title": "Kontrol Soruları",
      "type": "control-questions",
      "badge": "9 Kontrol",
      "questions": [
        {
          "id": "kriter1",
          "no": 1,
          "text": "Jeneratörün üzerinde markası modeli güç paneli ve kontrol kartı var mı?",
          "options": ["UYGUN", "UYGUN DEĞİL"],
          "default": "UYGUN"
        },
        {
          "id": "kriter2",
          "no": 2,
          "text": "Egzoz dumanı çıkışı için uygun önlemler alınmış mı?",
          "options": ["UYGUN", "UYGUN DEĞİL"],
          "default": "UYGUN"
        },
        {
          "id": "kriter3",
          "no": 3,
          "text": "Jeneratörün şebeke ile transferi için gerekli pano ve güç bağlantıları yapılmış mı?",
          "options": ["UYGUN", "UYGUN DEĞİL"],
          "default": "UYGUN"
        },
        {
          "id": "kriter4",
          "no": 4,
          "text": "Motor suyu ve yağ seviyesi kontrol ediliyor mu?",
          "options": ["UYGUN", "UYGUN DEĞİL"],
          "default": "UYGUN"
        },
        {
          "id": "kriter5",
          "no": 5,
          "text": "Yakıt tankı seviyesi kontrol ediliyor mu?",
          "options": ["UYGUN", "UYGUN DEĞİL"],
          "default": "UYGUN"
        },
        {
          "id": "kriter6",
          "no": 6,
          "text": "Yakıt tankı kapasitesi yeterli mi?",
          "options": ["UYGUN", "UYGUN DEĞİL"],
          "default": "UYGUN"
        },
        {
          "id": "kriter7",
          "no": 7,
          "text": "Jeneratör çalışması esnasında ses ve gürültü kontrlü yapılıyor mu?",
          "options": ["UYGUN", "UYGUN DEĞİL"],
          "default": "UYGUN"
        },
        {
          "id": "kriter8",
          "no": 8,
          "text": "Akü voltaj seviyesi uygun mu? Aküde şişme ve sızıntı oluyor mu?",
          "options": ["UYGUN", "UYGUN DEĞİL"],
          "default": "UYGUN"
        },
        {
          "id": "kriter9",
          "no": 9,
          "text": "Yetkili servis tarafından motor yağı, yağ filtresi, hava filtresi için periyodik olarak bakım yapılıyor mu?",
          "options": ["UYGUN", "UYGUN DEĞİL"],
          "default": "UYGUN"
        }
      ]
    },
    {
      "id": "kusur",
      "title": "İkaz ve Öneriler",
      "fields": [
        {
          "id": "ikazOneriler",
          "label": "İkaz ve Öneriler",
          "type": "textarea",
          "rows": 3,
          "placeholder": "Tespit edilen kusur ve önerileri açıklayın..."
        }
      ]
    },
    {
      "id": "sonuc",
      "title": "Sonuç ve Kanaat",
      "type": "sonuc",
      "sonucText": "Periyodik kontrol tarihi itibari ile yukarıda teknik özellikleri belirtilen \"Jeneratör\" mevcut şartlar altında"
    }
