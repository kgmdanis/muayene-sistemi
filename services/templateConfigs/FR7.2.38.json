          "options": ["Periyodik", "Düzeltme", "Yeni Tesis"],
          "placeholder": "Seçiniz"
        },
        {
          "id": "projeVarMi",
          "label": "Tesise Ait Elektrik Projesi Var Mı?",
          "type": "select",
          "options": ["Var", "Yok"],
          "placeholder": "Seçiniz"
        },
        {
          "id": "sebekeTipi",
          "label": "Şebeke Tipi",
          "type": "text",
          "placeholder": "3 Faz+Nötr"
