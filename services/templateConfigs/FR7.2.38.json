        {
          "id": "topraklayiciYuzeysel",
          "label": "Topraklayıcı - Yüzeysel",
          "type": "checkbox"
        },
        {
          "id": "topraklayiciDerin",
          "label": "Topraklayıcı - Derin",
          "type": "checkbox"
        }
