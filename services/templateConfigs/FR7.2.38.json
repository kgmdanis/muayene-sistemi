      "layout": "row-2",
      "fields": [
        {
          "id": "havaDurumu",
          "label": "Hava Durumu",
          "type": "select",
          "options": ["Açık", "Kapalı", "Yağışlı"],
          "placeholder": "Seçiniz"
        },
        {
          "id": "toprakDurumu",
          "label": "Toprak Durumu",
          "type": "select",
          "options": ["Islak", "Nemli", "Kuru"],
          "placeholder": "Seçiniz"
        },
        {
          "id": "kontrolNedeni",
          "label": "Kontrol Nedeni",
