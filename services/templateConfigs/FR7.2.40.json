{
  "sablonKodu": "FR7.2.40",
  "sablonAdi": "Elektrik İç Tesisat Ölçüm Raporu",
  "kategori": "elektrik",
  "altKategori": "elektrik",
  "raporNoPrefix": "MT",
  "ozelForm": true,
  "formUrl": "/forms/elektrik-ic-tesisat-form.html",
