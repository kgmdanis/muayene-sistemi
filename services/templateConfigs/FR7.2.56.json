      "type": "control-questions",
      "badge": "14 Kontrol",
      "questions": [
        {
          "id": "kriter1",
          "no": 1,
          "text": "İş ekipmanından kaynaklanacak parça kopması, fırlaması, v.b. tehlikelere karşı önlem alınmış mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter2",
          "no": 2,
          "text": "Bağlantılar ve vidaların kontrolü; eksik vida, gevşeklik, deformasyın durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter3",
          "no": 3,
          "text": "Hareketli ve dönen parçaların durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter4",
          "no": 4,
          "text": "Kumanda panelindeki anahtarların çalışma kontrolü durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter5",
          "no": 5,
          "text": "Kumanda cihazları; işaret, görülebilirlik, istem dışı hareket, acil stop durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter6",
          "no": 6,
          "text": "Taşların yüzeyleri uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter7",
          "no": 7,
          "text": "Taş dengeli bir şekilde dönmekte mi?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter8",
          "no": 8,
          "text": "Taşın siperlikleri uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter9",
          "no": 9,
          "text": "Taşlama makinasının koruyucu kapakları var mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter10",
          "no": 10,
          "text": "Taşlama makinasının mesnet aralığı 3 mm ‘nin üstünde midir?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter11",
          "no": 11,
          "text": "Taşlama makinasının dönme hızı motora uygun mudur?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter12",
          "no": 12,
          "text": "Taş üzerinde aşınma var mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter13",
          "no": 13,
          "text": "Taş bağlantı ve denge elemanları uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter14",
          "no": 14,
          "text": "Taşlama makinasında vibrasyon mevcut mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        }
      ]
    },
