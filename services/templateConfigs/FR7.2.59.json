      "questions": [
        {
          "id": "kriter1",
          "no": 1,
          "text": "Pres üzerinde güvenlik etiket ve işaretleri var mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter2",
          "no": 2,
          "text": "Pres etrafında tehlike yaratacak unsur var mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter3",
          "no": 3,
          "text": "Presin tüm koruyucu kapakları sağlam mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter4",
          "no": 4,
          "text": "Elektrik bağlantıları uygun mu ?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter5",
          "no": 5,
          "text": "Hidrolik yağı her 2500 saate değiştiriliyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter6",
          "no": 6,
          "text": "Kolon mili somunlarında gevşeme var mı ?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter7",
          "no": 7,
          "text": "Depo da ki yağ seviyesine uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter8",
          "no": 8,
          "text": "Emiş filtresi üç ayda bir kez pompadan sökülüp temizleniyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter9",
          "no": 9,
          "text": "Hidrolik devrelerin temizliği uygun olarak yapılıyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter10",
          "no": 10,
          "text": "Presin gövdesinde herhangi bir çatlak var mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter11",
          "no": 11,
          "text": "Presin acil stop butonu var mı? Aktif mi?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter12",
          "no": 12,
          "text": "Parça konulan yer dışında müdahale edilecek açıklık mevcut mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter13",
          "no": 13,
          "text": "Presin bulunduğu yerde ki aydınlatmalar yeterli mi?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter14",
          "no": 14,
          "text": "Presi kullanan kişi gerekli kişisel koruyucu donanımları kullanmakta mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        }
      ]
    },
