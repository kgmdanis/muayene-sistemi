    {
      "id": "kontrol",
      "title": "Tespit ve Değerlendirme",
      "type": "control-questions",
      "badge": "16 Kontrol",
      "questions": [
        {
          "id": "kriter1",
          "no": 1,
          "text": "İş ekipmanından kaynaklanacak parça kopması, fırlaması, v.b. tehlikelere karşı önlem alınmış mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter2",
          "no": 2,
          "text": "Bağlantılar ve vidaların kontrolü; eksik vida, gevşeklik, deformasyın durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter3",
          "no": 3,
          "text": "Hızlanma ve yavaşlama durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter4",
          "no": 4,
          "text": "Hareketli bir parçanın sabit bir parçaya yaklaşması durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter5",
          "no": 5,
          "text": "Kesme parçaları, elastik parçaların durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter6",
          "no": 6,
          "text": "Hareketli ve dönen parçaların durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter7",
          "no": 7,
          "text": "Pürüzlü, kaygan yüzey, zeminin durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter8",
          "no": 8,
          "text": "Keskin kenarlar durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter9",
          "no": 9,
          "text": "Elektrik kaynağı arızası, arıza koşullarında elektriksel gerilimli hale gelen parçaların durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter10",
          "no": 10,
          "text": "Elektrik motoru, pano, redüktör yağ sızıntı durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter11",
          "no": 11,
          "text": "Tezgahın boş durumda çalıştırılması durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter12",
          "no": 12,
          "text": "Kumanda panelindeki anahtarların çalışma kontrolü durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter13",
          "no": 13,
          "text": "Kumanda cihazları; işaret, görülebilirlik, istem dışı hareket, acil stop durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter14",
          "no": 14,
          "text": "Hidrolik sistemler, bağlantılar, sınırlama valfleri, sızıntı durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter15",
          "no": 15,
          "text": "Hareketli koruyucu kontrolü (varsa) durumu uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter16",
          "no": 16,
          "text": "Test sonunda yapılan gözle kontrolde, mekanizmalarda, metal yapısında, bağlantı elemanlarında, emniyeti bozacak bir şekil değiştirme, gevşeme, bozulma, kalıcı hasar vb. durumları uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        }
      ]
    },
    {
      "id": "kusur",
      "title": "İkaz ve Öneriler",
