    {
      "id": "kontrol",
      "title": "Tespit ve Değerlendirme",
      "type": "control-questions",
      "badge": "13 Kontrol",
      "questions": [
        {
          "id": "kriter1",
          "no": 1,
          "text": "Mengene kilitleme mekanizmasının arka ve yan koruyucuları uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter2",
          "no": 2,
          "text": "Kalıp bölümü koruyucu kapısı ve emniyet kilitleri uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter3",
          "no": 3,
          "text": "Kalıp bölümü üstten operatörün erişimini kısıtlayan önlemler alınmış mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter4",
          "no": 4,
          "text": "Kalıp ve mengene kısmına yandan ve alttan ulaşılmasını önleyecek koruyucular uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter5",
          "no": 5,
          "text": "Nozzle ( meme ) kısmının koruyucu ve emniyet sivici uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter6",
          "no": 6,
          "text": "Kovan ısıtıcıların korumaları ve uyarı levhaları uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter7",
          "no": 7,
          "text": "Huni bölgesinde vida kısmına erişimi önleyen koruyucular uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter8",
          "no": 8,
          "text": "Vida tahrik kısmındaki koruyucular uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter9",
          "no": 9,
          "text": "Elektrik tesisatı, kumanda paneli ve elektrik panoları uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter10",
          "no": 10,
          "text": "Kovan ve nozzle (meme) ısıtıcı elektrik bağlantı ve kabloları uygun mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter11",
          "no": 11,
          "text": "Hidrolik hortumlarda deformasyon, hidrolik sistemde yağ kaçağı var mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter12",
          "no": 12,
          "text": "Makinenin çevresinde ve yerlerde operatör açısından risk oluşturabilecek düzensiz malzeme , yağ sızıntısı, kablo, hortum v.b şeyler var mı?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        },
        {
          "id": "kriter13",
          "no": 13,
          "text": "Makine bakımları ve temizlikleri peryodik olarak yapılıyor mu?",
          "options": [
            "Uygun",
            "Uygun Değil"
          ],
          "default": "Uygun"
        }
      ]
    },
    {
      "id": "kusur",
      "title": "İkaz ve Öneriler",
      "fields": [
        {
          "id": "ikazOneriler",
          "label": "İkaz ve Öneriler",
          "type": "textarea",
          "rows": 3,
          "placeholder": "Tespit edilen kusur ve önerileri açıklayın..."
        }
      ]
    },
    {
